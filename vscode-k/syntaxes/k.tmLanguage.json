{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "K",
  "scopeName": "source.k",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#namespaces" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#enum-access" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-semicolon.k",
          "match": ";;.*$"
        },
        {
          "name": "comment.block.k",
          "begin": ";\\*",
          "end": "\\*;"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "(\\$unpack->|\\$entry->)\\s*(<)([^>]+)(>)",
          "captures": {
            "1": { "name": "keyword.control.directive.k" },
            "2": { "name": "punctuation.definition.tag.begin.k" },
            "3": { "name": "entity.name.namespace.k" },
            "4": { "name": "punctuation.definition.tag.end.k" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.k",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.k",
          "match": "\\\\."
        },
        {
          "name": "constant.other.placeholder.k",
          "match": "%(dd|d|s|c|b|u|%)"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.k",
      "match": "'(\\\\.|[^'\\\\])'"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.k",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.k",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.k",
          "match": "\\b[0-9][0-9_]*\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.k",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "name": "keyword.declaration.function.k",
          "match": "\\b(init::exec|init::isr|list::enum)\\b"
        },
        {
          "name": "support.function.builtin.k",
          "match": "\\b(safe::print|safe::getin|raw::asm|raw::inb|raw::outb|raw::inw|raw::outw)\\b"
        },
        {
          "name": "support.type.k",
          "match": "\\bsafe::str\\b"
        },
        {
          "name": "constant.language.k",
          "match": "\\bsafe::nul\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.k",
          "match": "\\b(ifd|else|for|while|break|continue|ret)\\b|>>do\\b"
        },
        {
          "name": "keyword.declaration.k",
          "match": "\\b(def|set|class|enum|pub|mut|ar)\\b"
        },
        {
          "name": "keyword.operator.sizeof.k",
          "match": "\\bsizeof\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.k",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f8|f16|f32|f64|double|bool|char|byte|void)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.k",
          "match": "\\b(true|false|nul)\\b"
        }
      ]
    },
    "enum-access": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(@|::)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "entity.name.type.enum.k" },
        "2": { "name": "punctuation.accessor.k" },
        "3": { "name": "constant.other.enum.k" }
      }
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\[)",
          "captures": {
            "1": { "name": "entity.name.function.k" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.k",
          "match": "->|::|\\*\\*|\\+\\+|--|<<|>>|==|!=|<=|=<|>=|&&|\\|\\||[+\\-*/%=<>!&|^~@]"
        }
      ]
    }
  }
}
